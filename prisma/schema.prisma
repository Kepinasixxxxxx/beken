generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  owner
  staff
}

enum OrderType {
  beli
  sewa
  custom
}

enum OrderStatus {
  pending
  dikonfirmasi
  diproses
  siap_diambil
  selesai
  dibatalkan
}

enum ItemType {
  product
  accessory
}

enum RentalStatus {
  dipesan
  diambil
  dikembalikan
  terlambat
}

enum PaymentType {
  dp
  pelunasan
  refund
}

enum PaymentStatus {
  menunggu
  terverifikasi
  ditolak
}

enum ActorType {
  user
  admin
}

model User {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  googleId     String?  @map("google_id") @db.VarChar(100)
  address      String?  @db.Text
  profilePhoto String?  @map("profile_photo") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  orders        Order[]
  conversations Conversation[]
  testimonials  Testimonial[]

  @@map("users")
}

model Admin {
  id           BigInt    @id @default(autoincrement())
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         AdminRole
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  conversations    Conversation[]
  verifiedPayments Payment[]            @relation("PaymentVerifiedBy")
  statusUpdates    OrderStatusHistory[]

  @@map("admins")
}

model StoreProfile {
  id               BigInt   @id @default(autoincrement())
  storeName        String   @map("store_name") @db.VarChar(100)
  description      String   @db.Text
  address          String   @db.Text
  phone            String   @db.VarChar(20)
  email            String?  @db.VarChar(100)
  whatsappNumber   String?  @map("whatsapp_number") @db.VarChar(20)
  socialMedia      String?  @map("social_media") @db.VarChar(255)
  logoImage        String?  @map("logo_image") @db.VarChar(255)
  operationalHours String?  @map("operational_hours") @db.VarChar(100)
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("store_profile")
}

model Category {
  id          BigInt  @id @default(autoincrement())
  name        String  @db.VarChar(100)
  description String? @db.Text

  products Product[]

  @@map("categories")
}

model Product {
  id                BigInt    @id @default(autoincrement())
  categoryId        BigInt    @map("category_id")
  name              String    @db.VarChar(150)
  description       String?   @db.Text
  basePriceBuy      Decimal?  @map("base_price_buy") @db.Decimal(12, 2)
  basePriceRent     Decimal?  @map("base_price_rent") @db.Decimal(12, 2)
  isCustomAvailable Boolean   @map("is_custom_available")
  isVisible         Boolean   @map("is_visible")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  category   Category         @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]

  @@map("products")
}

model ProductImage {
  id        BigInt  @id @default(autoincrement())
  productId BigInt  @map("product_id")
  imageUrl  String  @map("image_url") @db.VarChar(255)
  isPrimary Boolean @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id                BigInt    @id @default(autoincrement())
  productId         BigInt    @map("product_id")
  size              String    @db.VarChar(20)
  stockBuy          Int       @map("stock_buy")
  stockRent         Int       @map("stock_rent")
  priceBuyOverride  Decimal?  @map("price_buy_override") @db.Decimal(12, 2)
  priceRentOverride Decimal?  @map("price_rent_override") @db.Decimal(12, 2)
  deletedAt         DateTime? @map("deleted_at")

  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@unique([productId, size])
  @@map("product_variants")
}

model Accessory {
  id          BigInt    @id @default(autoincrement())
  name        String    @db.VarChar(150)
  description String?   @db.Text
  price       Decimal   @db.Decimal(12, 2)
  stock       Int
  imageUrl    String?   @map("image_url") @db.VarChar(255)
  deletedAt   DateTime? @map("deleted_at")

  orderItems OrderItem[]

  @@map("accessories")
}

model Order {
  id                 BigInt      @id @default(autoincrement())
  userId             BigInt      @map("user_id")
  orderNumber        String      @unique @map("order_number") @db.VarChar(30)
  orderType          OrderType   @map("order_type")
  requiresProduction Boolean     @default(false) @map("requires_production")
  status             OrderStatus @default(pending)
  totalPrice         Decimal     @map("total_price") @db.Decimal(12, 2)
  dpAmount           Decimal?    @map("dp_amount") @db.Decimal(12, 2)
  isLunas            Boolean     @default(false) @map("is_lunas")
  deadlineDate       DateTime?   @map("deadline_date") @db.Date
  expiredAt          DateTime?   @map("expired_at")
  notes              String?     @db.Text
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  user              User                 @relation(fields: [userId], references: [id])
  items             OrderItem[]
  customOrderDetail CustomOrderDetail?
  rental            Rental?
  payments          Payment[]
  statusHistory     OrderStatusHistory[]
  testimonials      Testimonial[]
  notifications     Notification[]

  @@map("orders")
}

model OrderItem {
  id               BigInt   @id @default(autoincrement())
  orderId          BigInt   @map("order_id")
  itemType         ItemType @map("item_type")
  productId        BigInt?  @map("product_id")
  productVariantId BigInt?  @map("product_variant_id")
  accessoryId      BigInt?  @map("accessory_id")
  quantity         Int
  size             String?  @db.VarChar(20)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal         Decimal  @db.Decimal(12, 2)

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
  accessory      Accessory?      @relation(fields: [accessoryId], references: [id])

  @@map("order_items")
}

model CustomOrderDetail {
  id                BigInt  @id @default(autoincrement())
  orderId           BigInt  @unique @map("order_id")
  designReference   String? @map("design_reference") @db.VarChar(255)
  designDescription String? @map("design_description") @db.Text
  jenisJenjang      String? @map("jenis_jenjang") @db.VarChar(50)
  consultationNote  String? @map("consultation_note") @db.Text

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("custom_order_details")
}

model Rental {
  id                  BigInt       @id @default(autoincrement())
  orderId             BigInt       @unique @map("order_id")
  pickupDate          DateTime     @map("pickup_date") @db.Date
  returnDate          DateTime     @map("return_date") @db.Date
  actualReturnDate    DateTime?    @map("actual_return_date") @db.Date
  itemConditionBefore String?      @map("item_condition_before") @db.Text
  itemConditionAfter  String?      @map("item_condition_after") @db.Text
  damageNote          String?      @map("damage_note") @db.Text
  penaltyAmount       Decimal?     @map("penalty_amount") @db.Decimal(12, 2)
  status              RentalStatus @default(dipesan)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("rentals")
}

model Payment {
  id                    BigInt        @id @default(autoincrement())
  orderId               BigInt        @map("order_id")
  paymentType           PaymentType   @map("payment_type")
  amount                Decimal       @db.Decimal(12, 2)
  paymentMethod         String?       @map("payment_method") @db.VarChar(50)
  midtransOrderId       String?       @map("midtrans_order_id") @db.VarChar(100)
  midtransTransactionId String?       @map("midtrans_transaction_id") @db.VarChar(100)
  proofImage            String?       @map("proof_image") @db.VarChar(255)
  refundReason          String?       @map("refund_reason") @db.Text
  refundDestination     String?       @map("refund_destination") @db.VarChar(100)
  status                PaymentStatus @default(menunggu)
  verifiedBy            BigInt?       @map("verified_by")
  verifiedAt            DateTime?     @map("verified_at")
  createdAt             DateTime      @default(now()) @map("created_at")

  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifier Admin? @relation("PaymentVerifiedBy", fields: [verifiedBy], references: [id])

  @@map("payments")
}

model OrderStatusHistory {
  id                 BigInt   @id @default(autoincrement())
  orderId            BigInt   @map("order_id")
  progressPercentage Int      @map("progress_percentage")
  statusLabel        String   @map("status_label") @db.VarChar(100)
  note               String?  @db.Text
  updatedBy          BigInt   @map("updated_by")
  createdAt          DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  admin Admin @relation(fields: [updatedBy], references: [id])

  @@map("order_status_history")
}

model Conversation {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  adminId       BigInt?   @map("admin_id")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id])
  admin    Admin?    @relation(fields: [adminId], references: [id])
  messages Message[]

  @@map("conversations")
}

model Message {
  id              BigInt    @id @default(autoincrement())
  conversationId  BigInt    @map("conversation_id")
  senderType      ActorType @map("sender_type")
  senderId        BigInt    @map("sender_id")
  messageText     String?   @map("message_text") @db.Text
  imageAttachment String?   @map("image_attachment") @db.VarChar(255)
  isRead          Boolean   @default(false) @map("is_read")
  createdAt       DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Notification {
  id             BigInt    @id @default(autoincrement())
  recipientType  ActorType @map("recipient_type")
  recipientId    BigInt    @map("recipient_id")
  type           String    @db.VarChar(50)
  title          String    @db.VarChar(150)
  message        String    @db.Text
  relatedOrderId BigInt?   @map("related_order_id")
  isRead         Boolean   @default(false) @map("is_read")
  createdAt      DateTime  @default(now()) @map("created_at")

  relatedOrder Order? @relation(fields: [relatedOrderId], references: [id])

  @@map("notifications")
}

model Testimonial {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  orderId    BigInt?  @map("order_id")
  rating     Int
  comment    String?  @db.Text
  isFeatured Boolean  @default(false) @map("is_featured")
  createdAt  DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@map("testimonials")
}

model PasswordReset {
  id          BigInt    @id @default(autoincrement())
  accountType ActorType @map("account_type")
  accountId   BigInt    @map("account_id")
  otpCode     String    @map("otp_code") @db.VarChar(10)
  expiresAt   DateTime  @map("expires_at")
  isUsed      Boolean   @default(false) @map("is_used")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("password_resets")
}

model RefreshToken {
  id          BigInt    @id @default(autoincrement())
  accountType ActorType @map("account_type")
  accountId   BigInt    @map("account_id")
  tokenHash   String    @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}
